{
	"name": "yummaui",
	"version": "0.1.0",
	"description": "Add Yumma UI components to your project.",
	"keywords": [
		"yummacss",
		"yumma-ui",
		"components",
		"base-ui",
		"cli"
	],
	"homepage": "https://yummacss.com/ui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yummacss/ui.git"
	},
	"license": "MIT",
	"author": "Renildo Pereira",
	"type": "module",
	"bin": {
		"yummaui": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"dev": "tsdown --watch",
		"lint": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.1",
		"@types/node": "^26.1.2",
		"tsdown": "^0.16.5",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@10.27.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
